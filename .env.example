NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App download page (/app). App Store link falls back to the App Store Connect id.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6822616728
# Leave empty until the Google Play listing is live: the page then shows "coming soon".
NEXT_PUBLIC_PLAY_STORE_URL=
# Shared with the API's PUBLIC_WEB_REVALIDATE_SECRET; lets a couple's save refresh their page at once.
REVALIDATE_SECRET=
